# syntax=docker/dockerfile:1.5
# CUDA 12.4 runtime + cuDNN — compatible with driver 570 / CUDA 12.8 on the host
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Ubuntu 22.04 ships Python 3.10 — matches the CPU image version
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install faster-whisper fastapi uvicorn python-multipart

COPY server.py /app/server.py
WORKDIR /app
EXPOSE 80

CMD ["python3", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "80"]
