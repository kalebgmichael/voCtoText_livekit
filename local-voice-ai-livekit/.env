LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# LLM — Ollama on host (M4 Mac, Metal acceleration)
LLAMA_BASE_URL=http://host.docker.internal:11434/v1
LLAMA_MODEL=gemma4:e4b

# STT — faster-whisper
STT_PROVIDER=whisper
STT_BASE_URL=http://whisper:80/v1
STT_MODEL=Systran/faster-whisper-small
STT_API_KEY=no-key-needed
VOXBOX_HF_REPO_ID=Systran/faster-whisper-small

# MCP servers — each MCP_*_URL env var is auto-registered as an MCPServerHTTP.
# Add a new line here to add another MCP server (must match a docker-compose service).
MCP_AIRBNB_URL=http://mcp_airbnb:8080/mcp
MCP_PLAYWRIGHT_URL=http://mcp_playwright:8080/sse

# TTS
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
